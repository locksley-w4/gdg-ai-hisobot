# Database credentials for docker-compose
POSTGRES_USER=auto_user
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=auto_db

# Shared proxy header for frontend/backend request validation
PROXY_HEADER=replace_with_random_high_entropy_value

# Backend login credentials
APP_BASIC_AUTH_USER=admin
APP_BASIC_AUTH_PASS=123

# Keep legacy behavior where any username/password can log in.
# Set to false to enforce strict login checks.
APP_AUTH_ALLOW_ANY_LOGIN=true

# Relative to backend/server.js, or set an absolute path.
APP_AUTH_USER_STORE_FILE=./users.json
