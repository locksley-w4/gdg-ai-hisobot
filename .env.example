# Core DB values for docker-compose
# Use strong values in production.
POSTGRES_USER=auto_user
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=auto_db

# Shared proxy header for frontend and backend
PROXY_HEADER=replace_with_random_high_entropy_value

# Backend login credentials used by /auth/login
APP_BASIC_AUTH_USER=admin
APP_BASIC_AUTH_PASS=replace_with_strong_password