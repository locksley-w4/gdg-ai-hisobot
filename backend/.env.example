API_BACKEND_HOST=0.0.0.0
API_BACKEND_PORT=5000
API_PAYLOAD_MAX_SIZE=7mb

GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_PROJECT=your-project-id
PROXY_HEADER=replace_with_same_value_as_root_env

GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=

APP_BASIC_AUTH_USER=admin
APP_BASIC_AUTH_PASS=123
APP_AUTH_TOKEN_TTL_MS=43200000
APP_AUTH_ALLOW_ANY_LOGIN=true
APP_AUTH_USER_STORE_FILE=./users.json
