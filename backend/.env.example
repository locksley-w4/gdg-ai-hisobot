API_BACKEND_HOST=0.0.0.0
API_BACKEND_PORT=5000
API_PAYLOAD_MAX_SIZE=7mb

GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_PROJECT=vertex-gdg-hackathon

# Must match frontend interceptor header
PROXY_HEADER=E2CGQbhhNArm5Ot9-y-yR5F_k0n0qK1S

# Vertex service account key mounted in container at /app/credentials
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=

# Basic auth creds for app login (change in production)
APP_BASIC_AUTH_USER=admin
APP_BASIC_AUTH_PASS=change_me_now